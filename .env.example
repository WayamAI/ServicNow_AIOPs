# Azure OpenAI Configuration
AIOPS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AIOPS_AZURE_OPENAI_API_KEY=your-api-key-here
AIOPS_AZURE_OPENAI_API_VERSION=2024-10-21
AIOPS_CODESTRAL_DEPLOYMENT=codestral
AIOPS_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini

# Database
AIOPS_DB_PATH=aiops.db

# Server
AIOPS_HOST=0.0.0.0
AIOPS_PORT=8000

# Monitoring
AIOPS_MONITOR_POLL_INTERVAL=15
AIOPS_MAX_INCIDENT_RETRIES=3
